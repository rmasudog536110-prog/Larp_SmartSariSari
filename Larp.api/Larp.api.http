###---------------------------------------###

### =====================================================================
### LARP demo data seeding. Run the requests TOP TO BOTTOM, one click each.
### Fill in the four @ variables below. Never put real passwords in a file you commit.
### Request variables like {{supplier1.response.body.$.supplierId}} read the
### result of an earlier request. If your Visual Studio does not evaluate them,
### replace them with the number from the earlier response.
### =====================================================================

### ---------------------------------------------------------------------
### 1. SUPER ADMIN LOGIN (only needed to create logins)
### ---------------------------------------------------------------------

# @name superLogin
POST {{Larp.api_HostAddress}}/auth/login
Content-Type: application/json

{
"username": "ralph@admin",
"password": "Larp@admin123"
}


### ---------------------------------------------------------------------
### 2. CREATE LOGINS (skip any that already exist; a repeat returns 409)
### Admin is created by SuperAdmin only. Employee codes must be unique.
### ---------------------------------------------------------------------

# @name createAdmin
POST {{Larp.api_HostAddress}}/admin/companies/{{companyId}}/users
Authorization: Bearer {{superLogin.response.body.$.token}}
Content-Type: application/json

{
  "username": "{{adminUser}}",
  "password": "{{adminPassword}}",
  "role": "Admin",
  "employeeCode": "EMP-A01",
  "firstName": "Alma",
  "lastName": "Reyes",
  "position": "Store Owner"
}

###

# @name createManager
POST {{Larp.api_HostAddress}}/admin/companies/{{companyId}}/users
Authorization: Bearer {{superLogin.response.body.$.token}}
Content-Type: application/json

{
  "username": "{{managerUser}}",
  "password": "{{managerPassword}}",
  "role": "Manager",
  "employeeCode": "EMP-M01",
  "firstName": "Mario",
  "lastName": "Santos",
  "position": "Store Manager"
}

###

# @name createStaff
POST {{Larp.api_HostAddress}}/admin/companies/{{companyId}}/users
Authorization: Bearer {{superLogin.response.body.$.token}}
Content-Type: application/json

{
  "username": "{{staffUser}}",
  "password": "{{staffPassword}}",
  "role": "Staff",
  "employeeCode": "EMP-S01",
  "firstName": "Sara",
  "lastName": "Cruz",
  "position": "Cashier"
}


### ---------------------------------------------------------------------
### 3. LOGIN AS ADMIN AND AS MANAGER (tokens are used by everything below)
### Admin: suppliers, approvals. Manager: products, stock, sales, purchases.
### (Admin cannot write products, inventory or sales by design.)
### ---------------------------------------------------------------------

# @name adminLogin
POST {{Larp.api_HostAddress}}/auth/login
Content-Type: application/json

{ "username": "{{adminUser}}", "password": "{{adminPassword}}" }

###

# @name managerLogin
POST {{Larp.api_HostAddress}}/auth/login
Content-Type: application/json

{ "username": "manager.store3", "password": "Store3@Manager2" }


### manager store 1
### eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7ekVxrNdDvuEyIAyvBWhxMimabvJzlo0S3lHXbFLLqc
###

### manager store 2
### eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ezLNFGziEEKJnoEa6IKAR6q87GiUbu3bpnkmMhbPI0Y
###

### manager store 3
### eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..8kXeGfjE0E8gRvKPayosCNYU_LEljz2o8L77yHPv0CY
###

### ---------------------------------------------------------------------
### 4. SUPPLIERS (Admin creates them already Approved)
### ---------------------------------------------------------------------

# @name supplier1
POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/suppliers
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "supplierCode": "SUP-001",
  "supplierName": "Astro Distributors",
  "contactPerson": "Jun Dela Cruz",
  "contactNumber": "09171234567",
  "emailAddress": "astro@example.com",
  "address": "Davao City"
}


### ---------------------------------------------------------------------
### 5. PRODUCTS (Manager)
### ---------------------------------------------------------------------

# @name product1
POST {{Larp.api_HostAddress}}/tenant/1/products
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7ekVxrNdDvuEyIAyvBWhxMimabvJzlo0S3lHXbFLLqc
Content-Type: application/json

{ "productCode": "PRD-001", "productName": "Minute Maid", "unitPrice": 65.00, "isActive": true }

###

# @name product2
POST {{Larp.api_HostAddress}}/tenant/1/products
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7ekVxrNdDvuEyIAyvBWhxMimabvJzlo0S3lHXbFLLqc
Content-Type: application/json

{ "productCode": "PRD-002", "productName": "Instant Noodles", "unitPrice": 18.00, "isActive": true }

###

# @name product3
POST {{Larp.api_HostAddress}}/tenant/1/products
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7ekVxrNdDvuEyIAyvBWhxMimabvJzlo0S3lHXbFLLqc
Content-Type: application/json

{ "productCode": "PRD-003", "productName": "Bottled Water", "unitPrice": 25.00, "isActive": true }


### ---------------------------------------------------------------------
### 6. STOCK IN through a PURCHASE (creates the inventory rows and
### writes stock movements). Manager token.
### ---------------------------------------------------------------------

# @name purchase1
POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/purchases
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{
  "supplierId": {{supplier1.response.body.$.supplierId}},
  "discount": 0,
  "items": [
    { "productId": {{product1.response.body.$.productId}}, "quantity": 50, "unitCost": 45.50 },
    { "productId": {{product2.response.body.$.productId}}, "quantity": 100, "unitCost": 12.00 },
    { "productId": {{product3.response.body.$.productId}}, "quantity": 8, "unitCost": 15.00 }
  ]
}


### ---------------------------------------------------------------------
### 7. REORDER LEVELS (makes the low-stock table and chart show something)
### Water has 8 on hand and a reorder level of 10, so it shows as Low Stock.
### This request sets the quantity too, so keep the quantities as bought.
### ---------------------------------------------------------------------

PUT {{Larp.api_HostAddress}}/tenant/{{companyId}}/inventory/{{product1.response.body.$.productId}}
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{ "quantityOnHand": 50, "reorderLevel": 10 }

###

PUT {{Larp.api_HostAddress}}/tenant/{{companyId}}/inventory/{{product2.response.body.$.productId}}
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{ "quantityOnHand": 100, "reorderLevel": 20 }

###

PUT {{Larp.api_HostAddress}}/tenant/{{companyId}}/inventory/{{product3.response.body.$.productId}}
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{ "quantityOnHand": 8, "reorderLevel": 10 }


### ---------------------------------------------------------------------
### 8. BRANCHES. Do this BEFORE the sales: a sale counts toward the
### branch of the employee who records it (the Manager here).
### ---------------------------------------------------------------------

# @name branch1
POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/branches
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "branchCode": "BR-001",
  "branchName": "Main Branch",
  "address": "Davao City",
  "contactNumber": "09170000001"
}

###

# @name branch2
POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/branches
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "branchCode": "BR-002",
  "branchName": "Toril Branch",
  "address": "Toril, Davao City",
  "contactNumber": "09170000002"
}

### Put the Manager in the main branch and the Staff member in the second one

PUT {{Larp.api_HostAddress}}/tenant/{{companyId}}/branches/{{branch1.response.body.$.branchId}}/employees/{{createManager.response.body.$.employeeId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

###

PUT {{Larp.api_HostAddress}}/tenant/{{companyId}}/branches/{{branch2.response.body.$.branchId}}/employees/{{createStaff.response.body.$.employeeId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}


### ---------------------------------------------------------------------
### 9. SALES (Manager token, so they count for Main Branch).
### The server takes the price from the product, so none is sent.
### ---------------------------------------------------------------------

POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/sales
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{
  "discount": 0,
  "saleItems": [
    { "productId": {{product1.response.body.$.productId}}, "quantity": 3, "discount": 0 },
    { "productId": {{product2.response.body.$.productId}}, "quantity": 10, "discount": 0 }
  ]
}

###

POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/sales
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{
  "discount": 0,
  "saleItems": [
    { "productId": {{product3.response.body.$.productId}}, "quantity": 2, "discount": 0 },
    { "productId": {{product1.response.body.$.productId}}, "quantity": 5, "discount": 0 }
  ]
}


### ---------------------------------------------------------------------
### 10. EXPENSES (category first, then the expense)
### ---------------------------------------------------------------------

# @name category1
POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/expense-categories
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{ "categoryName": "Electricity" }

###

POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/expenses
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{
  "expenseCategoryId": {{category1.response.body.$.expenseCategoryId}},
  "description": "October electricity bill",
  "amount": 2500,
  "expenseDate": "2026-10-01",
  "paymentMethod": "Cash",
  "status": "Paid"
}


### ---------------------------------------------------------------------
### 11. PAYROLL. It is created as Pending and does not count in the income
### statement until an Admin approves it (next step).
### ---------------------------------------------------------------------

# @name payroll1
POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/payroll
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{
  "employeeId": {{createStaff.response.body.$.employeeId}},
  "payPeriodStart": "2026-10-01",
  "payPeriodEnd": "2026-10-15",
  "basicSalary": 6000,
  "allowances": 500,
  "deductions": 200
}


### ---------------------------------------------------------------------
### 12. APPROVALS DEMO
### A Manager's supplier is Pending, then the Admin approves it.
### ---------------------------------------------------------------------

# @name supplier2
POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/suppliers
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{
  "supplierCode": "SUP-002",
  "supplierName": "Davao Beverage Trading",
  "contactPerson": "Lita Gomez",
  "contactNumber": "09181234567"
}

### What is waiting for approval (Admin)

GET {{Larp.api_HostAddress}}/tenant/{{companyId}}/approvals
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Approve the payroll (so it counts in the income statement)

POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/approvals/payroll/{{payroll1.response.body.$.payrollId}}/approve
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Approve the Manager's supplier (leave this one for the live demo if you prefer)

POST {{Larp.api_HostAddress}}/tenant/{{companyId}}/approvals/supplier/{{supplier2.response.body.$.supplierId}}/approve
Authorization: Bearer {{adminLogin.response.body.$.token}}


### ---------------------------------------------------------------------
### 13. CHECK THE RESULTS
### ---------------------------------------------------------------------

### Income statement for the month

GET {{Larp.api_HostAddress}}/tenant/{{companyId}}/reports/income-statement?startDate=2026-10-01&endDate=2026-10-31
Authorization: Bearer {{managerLogin.response.body.$.token}}

### Sales report (what the Dashboard uses)

GET {{Larp.api_HostAddress}}/tenant/{{companyId}}/reports/sales?startDate=2026-10-01&endDate=2026-10-31
Authorization: Bearer {{managerLogin.response.body.$.token}}

### Stock levels

GET {{Larp.api_HostAddress}}/tenant/{{companyId}}/inventory
Authorization: Bearer {{managerLogin.response.body.$.token}}

### Stock history for the first product

GET {{Larp.api_HostAddress}}/tenant/{{companyId}}/stock-movements/product/{{product1.response.body.$.productId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Branch totals

GET {{Larp.api_HostAddress}}/tenant/{{companyId}}/branches
Authorization: Bearer {{adminLogin.response.body.$.token}}

